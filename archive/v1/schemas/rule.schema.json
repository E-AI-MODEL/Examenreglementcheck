{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleRecord",
  "type": "object",
  "required": [
    "rule_id",
    "source_id",
    "topic",
    "norm_type",
    "rule_summary",
    "verification_status"
  ],
  "properties": {
    "rule_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "article": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": "string"
    },
    "norm_type": {
      "enum": [
        "mandatory",
        "prohibitive",
        "conditional",
        "procedural",
        "advisory"
      ]
    },
    "applies_when": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_summary": {
      "type": "string"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "exam_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "legal_regime": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "enum": [
        "draft",
        "pending_primary_verification",
        "validated",
        "superseded"
      ]
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "additionalProperties": true
}
