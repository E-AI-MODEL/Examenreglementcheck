{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "type": "object",
  "required": [
    "finding_id",
    "run_id",
    "document_location",
    "topic",
    "finding_type",
    "severity",
    "confidence",
    "claim",
    "evidence",
    "human_status",
    "suggested_action"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "document_location": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "article": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "anchor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "topic": {
      "type": "string"
    },
    "finding_type": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "enum": [
        "must",
        "legally_vulnerable",
        "recommended",
        "internal_conflict",
        "comparison",
        "editorial",
        "human_review"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "claim": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "case_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "article": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote_or_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "validator_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "fragment_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "suggested_action": {
      "type": "string",
      "minLength": 1
    },
    "suggested_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_status": {
      "enum": [
        "unreviewed",
        "accepted",
        "rejected",
        "needs_legal_review",
        "implemented",
        "resolved"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "in_change_set": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "const": "must"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "rule_id",
                "fragment_id",
                "validator_status"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "rule_id": {
                  "type": "string"
                },
                "fragment_id": {
                  "type": "string"
                },
                "validator_status": {
                  "const": "validated"
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
